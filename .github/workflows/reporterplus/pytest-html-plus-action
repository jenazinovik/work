name: Pytest with Beautiful Report

on: [push]

jobs:
  test:
    runs-on: ubuntu-latest
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Setup Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.x'
    
    - name: Install dependencies
      run: pip install pytest pytest-html
    
    - name: Generate Pytest Report
      uses: reporterplus/pytest-html-plus-action@v3
      with:
        test_path: ./
        generate_xml: true  # Сгенерировать XML для дополнительных отчетов
